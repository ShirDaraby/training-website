<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="page_contact_booking" model="website.page">
        <field name="name">contact_booking</field>
        <field name="is_published" eval="True"/>
        <field name="key">website_bootstrap.page_contact_booking</field>
        <field name="url">/contact_booking</field>
        <field name="website_id">1</field>
