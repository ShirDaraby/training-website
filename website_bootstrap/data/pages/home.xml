<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Disable Default Home -->
    <record id="website.homepage" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!-- Home -->
    <record id="page_home" model="website.page">
        <field name="name">Home</field>
        <field name="is_published" eval="True"/>
        <field name="key">website_bootstrap.page_home</field>
        <field name="url">/</field>
        <field name="website_id">1</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t name="Home" t-name="website_bootstrap.page_home">
                <!-- Title -->
                <t t-set="additional_title" t-value="'bootstrap homepage'"/>
                <!-- Content -->
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">

                        <!-- Main banner -->
                        <section class="s_text_image pt80 pb80">
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="col-lg-6 pt16 pb16">
                                        <h2>A Section Subtitle test</h2>
                                        <p>Write one or two paragraphs describing your product or services. To be successful your content needs to be useful to your readers.</p>
                                        <p>Start with the customer - find out what they want and give it to them.</p>
                                        <p><a href="#" class="btn btn-primary">Learn more</a></p>
                                    </div>
                                    <div class="col-lg-6 pt16 pb16">
                                        <!-- <svg xmlns="http://www.w3.org/2000/svg" style="max-width: 290.859375px;" viewBox="0 0 290.859375 421.78125">…</svg> -->
                                        <img src="/website_bootstrap/static/src/img/drone.png" class="img img-fluid mx-auto" alt="" data-original-mimetype="image/png" data-file-name="01.svg" data-shape="theme_test_custo/blob/01" data-shape-colors=";;;;"/>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- 2 sections -->
                        <section class="s_text_block o_colored_level o-color-2 pt64 pb32 parallax s_parallax_is_fixed s_parallax_no_overflow_hidden" data-snippet="s_text_block" data-name="Text" style="background-image: linear-gradient(rgb(0, 0, 0) 0%, rgb(75, 85, 99) 100%);" data-oe-shape-data="{'shape':'illustration/airproof/waves2','colors':{'c1':'#BBE1FA'},'flip':[]}">
                            <div class="s_parallax_bg oe_img_bg o_bg_img_center x_main_banner"/>
                            <div class="container">
                                <div class="s_allow_columns o_container_large row justify-content-center">
                                    <img src="/website_bootstrap/static/src/img/logo-rdsag.svg" class="col-12 align-items-center w-25"/>
                                    <h1 class="col-12 fw-bold text-center text-o-color-4">Enter the House <strong class="x_stroke_text">of Art!</strong></h1>
                                    <h3 class="font-weight-bold text-center justify-content-center align-items-center text-o-color-4">A unique place in the center of Bratislava at Laurinská 14 , where you can find dance, singing, acting, exercise as well as the Slovak Dance Theater under one roof!
                                    </h3>
                                </div>
                                <!-- <div class="x_cards">
                                    <p>test</p>
                                </div> -->

                                <!-- <div class="row d-flex justify-content-center align-items-center w-25 x_test">
                                    <a href="#">
                                    <img src="website_bootstrap/static/src/img/clanoknahlad.webp" class="container img img-fluid mx-auto rounded o_we_bg_filter" style="background-image: linear-gradient(135deg, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.15) 100%) !important;"/>
                                        <h4 class="fw-bold mt-3 o-cc-1">Date</h4>
                                    </a>
                                </div> -->

                                
                                <div class="container s_allow_columns">
                                    <div class="row d-flex justify-content-center align-items-center">
                                        <div class="pt32 pb32 col-lg-2">
                                            <div class="row rounded x_circle mx-auto d-flex justify-content-center align-items-center x_card_class x_card_class1">
                                                <img src="/website_bootstrap/static/src/img/riverpark_logo" alt="4K image" data-mimetype="image/svg" class="img x_card_img justify-content-center align-items-center"/>
                                                <div class="card_description text-start">
                                                    <p class="text-o-color-4 fw-bold">Age: 0-10</p>
                                                    <h5 class="mt-3 fw-bold text-o-color-4">Riverpark dance school</h5>
                                                    <p class="text-o-color-4">The widest range of dance lessons and exercises in Bratislava. Open hours and courses for the public in modern premises.</p>
                                                    <p class="text-o-color-4 fw-bold">Find out more</p>
                                                </div> 
                                            </div>
                                        </div>

                                        <div class="pt32 pb32 col-lg-2">
                                            <div class="o_cc o_cc3 rounded x_circle mx-auto d-flex justify-content-center align-items-center x_card_class x_card_class2">
                                                <img src="/website_bootstrap/static/src/img/riverpark-logo.png" alt="4K image" data-mimetype="image/svg" class="x_card_img justify-content-center align-items-center"/>
                                                <div class="card_description text-start">
                                                    <p class="text-o-color-4 fw-bold">Age: 4-31</p>
                                                    <h5 class="mt-3 fw-bold text-o-color-4">Souljam</h5>
                                                    <p class="text-o-color-4">Hip-Hop dance group. Workshops, battles, performances at events.</p>
                                                    <p class="text-o-color-4 fw-bold">Find out more</p>
                                                </div> 
                                            </div>
                                        </div>

                                        <div class="pt32 pb32 col-lg-2">
                                            <div class="o_cc o_cc3 rounded x_circle mx-auto d-flex justify-content-center align-items-center x_card_class x_card_class3">
                                                <img src="/website_bootstrap/static/src/img/riverpark_logo" alt="class logo image" data-mimetype="image/svg" class="x_card_img justify-content-center align-items-center"/>
                                                <div class="card_description text-start">
                                                    <p class="text-o-color-4 fw-bold">Age: 4-31</p>
                                                    <h5 class="mt-3 fw-bold text-o-color-4">Souljam</h5>
                                                    <p class="text-o-color-4">Hip-Hop dance group. Workshops, battles, performances at events.</p>
                                                    <p class="text-o-color-4 fw-bold">Find out more</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="pt32 pb32 col-lg-2">
                                            <div class="o_cc o_cc3 rounded x_circle mx-auto d-flex justify-content-center align-items-center x_card_class x_card_class4">
                                                <img src="/website_bootstrap/static/src/img/riverpark_logo" alt="4K image" data-mimetype="image/svg" class="x_card_img justify-content-center align-items-center"/>
                                                <div class="card_description text-start">
                                                    <p class="text-o-color-4 fw-bold">Age: 4-31</p>
                                                    <h5 class="mt-3 fw-bold text-o-color-4">Souljam</h5>
                                                    <p class="text-o-color-4">Hip-Hop dance group. Workshops, battles, performances at events.</p>
                                                    <p class="text-o-color-4 fw-bold">Find out more</p>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="pt32 pb32 col-lg-2">
                                            <div class="o_cc o_cc3 rounded x_circle mx-auto d-flex justify-content-center align-items-center x_card_class x_card_class5">
                                                <img src="/website_bootstrap/static/src/img/riverpark_logo" alt="4K image" data-mimetype="image/svg" class="x_card_img justify-content-center align-items-center"/>
                                                <div class="card_description text-start">
                                                    <p class="fw-bold">Age: 4-31</p>
                                                    <h5 class="mt-3 fw-bold">Souljam</h5>
                                                    <p>Hip-Hop dance group. Workshops, battles, performances at events.</p>
                                                    <p class="fw-bold">Find out more</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-center align-items-center" style="min-height: 325px;">
                                        <p><a href="#" class="btn btn-primary x_btn_left_gradient">Sign up</a></p>
                                        <p><a href="#" class="btn btn-primary x_btn_middle_gradient">I want to walk around the House of Art</a></p>
                                        <p><a href="#" class="btn btn-primary">Login</a></p>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- adding map -->
                        <!-- <template id="s_map_options" inherit_id="website.snippet_options">
                        </template> -->
                        <template name="Map" id="s_map">
                            <section class="s_map pb56 pt56" data-map-type="m" data-map-zoom="12" t-att-data-map-address="' '.join(filter(None, (user_id.company_id.street, user_id.company_id.city, user_id.company_id.state_id.display_name, user_id.company_id.country_id.display_name)))">
                                <div class="map_container o_not_editable">
                                    <div class="css_non_editable_mode_hidden">
                                        <div class="missing_option_warning alert alert-info rounded-0 fade show d-none d-print-none">
                                            An address must be specified for a map to be embedded
                                        </div>
                                    </div>
                                    <iframe t-if="not test_mode_enabled" class="s_map_embedded o_not_editable" src="https://maps.google.com/maps?q=250%20Executive%20Park%20Blvd%2C%20Suite%203400%20San%20Francisco%20California%20(US)%20United%20States&amp;t=m&amp;z=12&amp;ie=UTF8&amp;iwloc=&amp;output=embed" width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" aria-label="Map"/>
                                    <div class="s_map_color_filter"/>
                                </div>
                            </section>
                        </template>


                        <!-- section news - events -->
                        <section class="s_text_block o_colored_level o-color-2 pt64 pb32" data-snippet="s_text_block" data-name="Text" style="background-image: linear-gradient(rgb(28, 30, 34) 0%, rgb(75, 85, 99) 100%);" data-oe-shape-data="{'shape':'illustration/airproof/waves2','colors':{'c1':'#BBE1FA'},'flip':[]}">
                            <div class="s_allow_columns o_container_large">
                                <h2 class="fw-bold text-center text-o-color-4">NEWS</h2>
                            </div>
                            <div class="row d-flex justify-content-center align-items-start" style="min-height: 325px;">
                                <div class="pt32 pb32 col-lg-2 x_card_news x_card_news_home">
                                <a href="#">
                                    <img src="website_bootstrap/static/src/img/clanoknahlad.webp" class="img img-fluid mx-auto rounded"/>
                                    <h4 class="x_date fw-bold mt-3 text-start">Date</h4>
                                    <h4 class="fw-bold mt-3 text-o-color-4 text-start">SILENT VIBE IS NEW IN THE SUMMER SCHEDULE</h4>
                                    <p class="text-o-color-4 text-start">An hour where music becomes your private world. Feel like you're at a Silent Disco.</p>
                                </a>
                                </div>

                                <div class="pt32 pb32 col-lg-2 x_card_news x_card_news_home">
                                <a href="#">
                                    <img src="/website_bootstrap/static/src/img/nahlad.webp" class="img img-fluid mx-auto rounded"/>
                                    <h4 class="x_date fw-bold mt-3 text-start">Date</h4>
                                    <h4 class="fw-bold mt-3 text-o-color-4 text-start">SUMMER SCHEDULE IN THE HOUSE OF ART</h4>
                                    <p class="text-o-color-4 text-start">Check out the news that we have prepared for you in the summer schedule.</p>
                                </a>
                                </div>

                                <div class="pt32 pb32 col-lg-2 x_card_news x_card_news_home">
                                <a href="#">
                                    <img src="/website_bootstrap/static/src/img/IDOLWEEK.webp" class="img img-fluid mx-auto rounded"/>
                                    <h4 class="x_date fw-bold mt-3 text-start">Date</h4>
                                    <h4 class="fw-bold mt-3 text-o-color-4 text-start">IDOL WEEK</h4>
                                    <p class="text-o-color-4 text-start">An hour where music becomes your private world. Feel like you're at a Silent Disco.</p>
                                </a>
                                </div>

                                <div class="pt32 pb32 col-lg-2 x_card_news x_card_news_home">
                                <a href="#">
                                    <img src="/website_bootstrap/static/src/img/letneclenstvo.webp" class="img img-fluid mx-auto rounded" alt="Glasses icon" data-mimetype="image/webp"/>
                                    <h4 class="x_date fw-bold mt-3 text-start">Date</h4>
                                    <h4 class="fw-bold mt-3 text-o-color-4 text-start">SUMMER MEMBERSHIP IN THE HOUSE OF ART</h4>
                                    <p class="text-o-color-4 text-start">An hour where music becomes your private world. Feel like you're at a Silent Disco.</p>
                                </a>
                                </div>
                            </div>
                            <div class="d-flex justify-content-center">
                                <p><a href="#" class="btn btn-primary x_btn_orange_red_gradient">I want to walk around the House of Art</a></p>
                            </div>
                        </section>

