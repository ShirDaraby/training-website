<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="page_news" model="website.page">
        <field name="name">news</field>
        <field name="is_published" eval="True"/>
        <field name="key">website_bootstrap.page_news</field>
        <field name="url">/news</field>
        <field name="website_id">1</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t name="Home" t-name="website_bootstrap.page_news">
                <!-- Title -->
                <t t-set="additional_title" t-value="'RDS News'"/>
                <!-- Content -->
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure" style="background-image: linear-gradient(rgb(28, 30, 34) 100%, rgb(99, 103, 107) 85%);">
                        <!-- <div style="background-image: url(/web_editor/shape/illustration/bootstrap/testpattern.svg?c1=%23BBE1FA);"> -->
                        <div style="background-image: url(/web_editor/shape/illustration/bootstrap/waves3.svg?c1=%23BBE1FA);">
                            

                            <!-- <section class="s_text_block o-cc2-bg pt64 pb32" data-snippet="s_text_block" data-name="Text"> -->
                            <section class="s_text_block o-cc2-bg pt64 pb32 container" data-snippet="s_text_block" data-name="Text">
                                    <h3 class="fw-bold text-start text-o-color-4">WHAT'S NEW <strong class="x_stroke_text">IN OUR WORLD</strong></h3>
                                    <div class="row d-flex justify-content-evely align-items-start" style="min-height: 325px;">
                                        <div class="pt32 pb32 col-lg-3">
                                        <a href="#">
                                            <img src="website_bootstrap/static/src/img/clanoknahlad.webp" class="img img-fluid mx-auto rounded"/>
                                            <h5 class="x_date fw-bold mt-3 text-start">Date</h5>
                                            <h5 class="fw-bold mt-3 text-o-color-4 text-start">SILENT VIBE IS NEW IN THE SUMMER SCHEDULE</h5>
                                            <p class="text-o-color-4 text-start">An hour where music becomes your private world. Feel like you're at a Silent Disco.</p>
                                        </a>
                                        </div>

                                        <div class="pt32 pb32 col-lg-3">
                                        <a href="#">
                                            <img src="/website_bootstrap/static/src/img/nahlad.webp" class="img img-fluid mx-auto rounded"/>
                                            <h4 class="x_date fw-bold mt-3 text-start">Date</h4>
                                            <h4 class="fw-bold mt-3 text-o-color-4 text-start">SUMMER SCHEDULE IN THE HOUSE OF ART</h4>
                                            <p class="text-o-color-4 text-start">Check out the news that we have prepared for you in the summer schedule.</p>
                                        </a>
                                        </div>

                                        <div class="pt32 pb32 col-lg-3">
                                        <a href="#">
                                            <img src="/website_bootstrap/static/src/img/IDOLWEEK.webp" class="img img-fluid mx-auto rounded"/>
                                            <h4 class="x_date fw-bold mt-3 text-start">Date</h4>
                                            <h4 class="fw-bold mt-3 text-o-color-4 text-start">IDOL WEEK</h4>
                                            <p class="text-o-color-4 text-start">An hour where music becomes your private world. Feel like you're at a Silent Disco.</p>
                                        </a>
                                        </div>

                                        <div class="pt32 pb32 col-lg-3">
                                        <a href="#">
                                            <img src="/website_bootstrap/static/src/img/letneclenstvo.webp" class="img img-fluid mx-auto rounded" alt="Glasses icon" data-mimetype="image/webp"/>
                                            <h4 class="x_date fw-bold mt-3 text-start">Date</h4>
                                            <h4 class="fw-bold mt-3 text-o-color-4 text-start">SUMMER MEMBERSHIP IN THE HOUSE OF ART</h4>
                                            <p class="text-o-color-4 text-start">An hour where music becomes your private world. Feel like you're at a Silent Disco.</p>
                                        </a>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-center">
                                        <p><a href="#" class="btn btn-primary x_btn_orange_red_gradient">I want to walk around the House of Art</a></p>
                                    </div>
                            </section>

                        </div>
                    </div>
                </t>
            </t>
        </field>
    </record>

</odoo>
